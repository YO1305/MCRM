rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /design_requests/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    match /tasks/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024;
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /catalogues/{catalogueId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 40 * 1024 * 1024
        && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.position
            in ['designer', 'head', 'leads_manager_1', 'leads_manager_2']
        );
    }
  }
}
