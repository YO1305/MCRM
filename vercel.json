{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/kpi-lead-override.js": {
      "maxDuration": 30
    },
    "api/ai-lead-analysis.js": {
      "maxDuration": 60
    },
    "api/ai-activity-analysis.js": {
      "maxDuration": 60
    },
    "api/ai-test-prompt.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/ai-lead-analysis",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/ai-activity-analysis",
      "schedule": "20 3 * * *"
    }
  ]
}
